{
  "name": "answercue",
  "version": "2.8.8",
  "main": "dist-electron/electron/main.js",
  "description": "AnswerCue is a live interview assistant that helps prepare context, transcribe conversations, and generate AI-guided answers.",
  "scripts": {
    "clean": "rimraf dist dist-electron",
    "dev": "vite",
    "build": "npm run clean && tsc && vite build",
    "build:electron": "node scripts/build-electron.js",
    "build:electron:tsc": "tsc -p electron/tsconfig.json",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "verify:package-inputs": "node scripts/verify-package-inputs.js",
    "preview": "vite preview",
    "postinstall": "cross-env SHARP_IGNORE_GLOBAL_LIBVIPS=1 npm rebuild sharp && electron-rebuild -f -w better-sqlite3,keytar && node scripts/patch-electron-plist.js",
    "electron:dev": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build:electron && cross-env NODE_ENV=production electron .",
    "app:dev": "concurrently \"npm run dev -- --port 5180 --strictPort\" \"wait-on http://localhost:5180 && npm run electron:dev\"",
    "app:build": "npm run build && cross-env ANSWERCUE_PRODUCTION_BUILD=1 npm run build:electron && cross-env ANSWERCUE_BUILD_ALL_MAC_ARCHES=1 npm run build:native && node scripts/ensure-sharp-mac-deps.js && electron-builder",
    "app:build:signed": "npm run build && cross-env ANSWERCUE_PRODUCTION_BUILD=1 npm run build:electron && cross-env ANSWERCUE_BUILD_ALL_MAC_ARCHES=1 npm run build:native && node scripts/ensure-sharp-mac-deps.js && electron-builder --config electron-builder.signed.cjs",
    "watch": "tsc -p electron/tsconfig.json --watch",
    "start": "npm run app:dev",
    "dist": "npm run app:build",
    "dist:signed": "npm run app:build:signed",
    "build:native": "node scripts/build-native.js",
    "test": "npm run build:electron && node --test 'electron/services/__tests__/**/*.test.mjs' 'electron/llm/__tests__/**/*.test.mjs' 'electron/audio/__tests__/**/*.test.mjs'",
    "test:modes": "npm run build:electron && node --test electron/services/__tests__/Mode*.test.mjs electron/services/__tests__/ProfileIntelligenceGate.test.mjs electron/services/__tests__/AnswerCueApiE2E.test.mjs",
    "test:modes:no-build": "node --test electron/services/__tests__/Mode*.test.mjs electron/services/__tests__/ProfileIntelligenceGate.test.mjs electron/services/__tests__/AnswerCueApiE2E.test.mjs",
    "test:modes:collect-fixtures": "RUN_INTERNET_FIXTURE_COLLECTION=1 node --test electron/services/__tests__/ModeFixtureIntegrity.test.mjs",
    "test:modes:e2e": "RUN_ANSWERCUE_API_E2E=1 npm run test:modes",
    "test:modes:long": "node --test electron/services/__tests__/ModeLongSession.test.mjs",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:parity": "ELECTRON_E2E=1 ELECTRON_APP_PORT=${ELECTRON_APP_PORT:-5173} npx playwright test tests/e2e/parity-gaps-evidence.spec.ts",
    "bench:screen-understanding": "npm run build:electron && node scripts/bench-screen-understanding.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "build": {
    "generateUpdatesFilesForAllChannels": true,
    "appId": "com.answercue.desktop",
    "afterPack": "./scripts/ad-hoc-sign.js",
    "productName": "AnswerCue",
    "files": [
      "dist/**",
      "dist-electron/**",
      "native-module/index.js",
      "native-module/package.json",
      "native-module/index.${platform}-${arch}{,-gnu,-msvc}.node",
      "package.json",
      "LICENSE",
      "LICENSES/**",
      "!**/node_modules/**/*.map",
      "!**/node_modules/pdf-parse/dist/**/{esm,web}{,/**}",
      "!**/node_modules/pdfjs-dist/web{,/**}"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dylib",
      "dist-electron/electron/pdf.worker.mjs"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "icon.png",
          "iconTemplate.png",
          "answercue/answercue.icns",
          "fakeicon/${os}/**",
          "icons/${os}/**"
        ]
      },
      {
        "from": "assets/answercue/answercue.icns",
        "to": "answercue.icns"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/answercue/answercue.icns",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "AnswerCue needs Screen Recording permission to capture system audio for interview transcription.",
        "NSMicrophoneUsageDescription": "AnswerCue needs microphone access to transcribe your voice during interviews.",
        "NSAudioCaptureUsageDescription": "AnswerCue needs system audio access to transcribe interview audio."
      },
      "files": [
        "dist/**",
        "dist-electron/**",
        "native-module/index.js",
        "native-module/package.json",
        "native-module/index.${platform}-${arch}{,-gnu,-msvc}.node",
        "package.json",
        "LICENSE",
        "LICENSES/**",
        "!**/node_modules/**/*.map",
        "!**/node_modules/pdf-parse/dist/**/{esm,web}{,/**}",
        "!**/node_modules/pdfjs-dist/web{,/**}",
        "!**/node_modules/@img/!(colour|sharp-darwin-${arch}|sharp-libvips-darwin-${arch}){,/**}",
        "!**/node_modules/@napi-rs/canvas-!(darwin-${arch}){,/**}"
      ]
    },
    "dmg": {
      "size": "4g",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/win/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/png/",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "devasheeshG",
        "repo": "AnswerCue",
        "releaseType": "release"
      }
    ],
    "afterAllArtifactBuild": "./scripts/afterAllArtifactBuild.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.3",
    "@napi-rs/cli": "^3.5.1",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/color": "^4.2.0",
    "@types/electron": "^1.4.38",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.4.49",
    "react-doctor": "^0.2.10",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1",
    "@google-cloud/speech": "^7.2.1",
    "@deepgram/sdk": "^3.13.0",
    "@anthropic-ai/sdk": "^0.74.0",
    "@bany/curl-to-json": "^1.2.10",
    "@google/genai": "^1.44.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "@tanstack/react-query": "^5.100.10",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.7.7",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "form-data": "^4.0.1",
    "framer-motion": "^12.29.2",
    "groq-sdk": "^0.37.0",
    "jspdf": "^4.0.0",
    "katex": "^0.16.27",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.11.0",
    "marked": "^18.0.4",
    "openai": "^6.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tesseract.js": "^5.0.5",
    "tree-kill": "^1.2.2",
    "uuid": "^11.0.3",
    "ws": "^8.19.0"
  },
  "dependencies": {
    "better-sqlite3": "12.6.2",
    "keytar": "^7.9.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.34.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "google-auth-library": "^10.6.2"
  }
}
